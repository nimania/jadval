rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isEditor() {
   return request.auth != null && request.auth.token.email_verified == true &&
    request.auth.token.firebase.sign_in_provider == 'google.com' &&
    get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
  }
  function bank() { return get(/databases/$(database)/documents/meta/bank).data; }
  function bankAfter() { return getAfter(/databases/$(database)/documents/meta/bank).data; }
  function validEntry(d) {
   return d.keys().hasAll(['id','answer','clue','letters','category','difficulty','reviewed','source','license','legacy','revision','generation','createdAt','updatedAt']) &&
    d.keys().hasOnly(['id','answer','clue','letters','category','difficulty','reviewed','source','license','legacy','revision','generation','createdAt','updatedAt']) &&
    d.id is string && d.id.size()>0 && d.id.size()<=500 &&
    d.answer is string && d.answer.size()>0 && d.answer.size()<=160 &&
    d.clue is string && d.clue.size()>0 && d.clue.size()<=1500 &&
    d.letters is int && d.letters>=1 && d.letters<=30 &&
    d.category is string && d.difficulty is string && d.source is string && d.license is string && d.legacy is map &&
    d.reviewed is int && d.reviewed in [0,1] && d.revision is int && d.revision>=1 &&
    d.generation is int && d.generation>=0 && d.createdAt is timestamp && d.updatedAt==request.time;
  }
  function editing(entryId,added) {
   return bank().status=='ready' && bankAfter().status=='ready' &&
    bankAfter().generation==bank().generation+1 &&
    request.resource.data.generation==bankAfter().generation &&
    bankAfter().lastEntry==entryId && bankAfter().count==bank().count+added;
  }
  match /admins/{uid} {
   allow get: if request.auth!=null && request.auth.uid==uid;
   allow list,create,update,delete: if false;
  }
  match /entries/{entryId} {
   allow read: if isEditor();
   allow create: if isEditor() && validEntry(request.resource.data) && request.resource.data.revision==1 &&
    request.resource.data.createdAt==request.time &&
    ((bank().status=='importing' && bank().owner==request.auth.uid && request.resource.data.generation==0) || editing(entryId,1));
   // During migration batch.set may create only: it can NEVER overwrite a racing or existing document.
   allow update: if isEditor() && validEntry(request.resource.data) && editing(entryId,0) &&
    request.resource.data.id==resource.data.id && request.resource.data.createdAt==resource.data.createdAt &&
    request.resource.data.revision==resource.data.revision+1;
   allow delete: if false;
  }
  function validMeta(d) {
   return d.keys().hasAll(['schema','status','owner','expected','fingerprint','startedAt']) &&
    d.keys().hasOnly(['schema','status','owner','expected','fingerprint','startedAt','completedAt','count','generation','lastEntry']) &&
    d.schema==2 && d.owner is string && d.expected is int && d.expected>0 &&
    d.fingerprint is string && d.fingerprint.matches('^[a-f0-9]{64}$') && d.startedAt is timestamp;
  }
  match /meta/bank {
   allow read: if isEditor();
   allow create: if isEditor() && validMeta(request.resource.data) &&
    request.resource.data.status=='importing' && request.resource.data.owner==request.auth.uid &&
    request.resource.data.startedAt==request.time;
   allow update: if isEditor() && validMeta(request.resource.data) &&
    request.resource.data.owner==resource.data.owner && request.resource.data.expected==resource.data.expected &&
    request.resource.data.fingerprint==resource.data.fingerprint && request.resource.data.startedAt==resource.data.startedAt &&
    ((resource.data.status=='importing' && resource.data.owner==request.auth.uid &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','count','generation','completedAt']) &&
      request.resource.data.status=='ready' && request.resource.data.count==resource.data.expected &&
      request.resource.data.generation==0 && request.resource.data.completedAt==request.time) ||
     (resource.data.status=='ready' && request.resource.data.status=='ready' &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count','generation','lastEntry']) &&
      request.resource.data.generation==resource.data.generation+1 &&
      request.resource.data.count is int && request.resource.data.count>=resource.data.count && request.resource.data.count<=resource.data.count+1 &&
      request.resource.data.lastEntry is string &&
      getAfter(/databases/$(database)/documents/entries/$(request.resource.data.lastEntry)).data.generation==request.resource.data.generation));
   allow delete: if false;
  }
  // Published grid data is an editor-reviewed JSON string. Firestore does not
  // accept nested arrays inside a document (the v3 grid uses row arrays).
  // Bank entries, drafts and admin data are never made public.
  function validPublicPuzzle(d, puzzleId) {
   return d.keys().hasAll(['id','title','size','publishedAt','approvedBy','editorApproved','puzzleJson']) &&
    d.keys().hasOnly(['id','title','size','publishedAt','approvedBy','editorApproved','puzzleJson']) &&
    d.id == puzzleId && d.id is string && d.id.matches('^pub_[A-Za-z0-9_-]{12,80}$') &&
    d.title is string && d.title.size()>0 && d.title.size()<=120 &&
    d.size is int && d.size in [7,10,15,20] &&
    d.publishedAt == request.time && d.approvedBy == request.auth.uid &&
    d.editorApproved == true &&
    d.puzzleJson is string && d.puzzleJson.size()>30 && d.puzzleJson.size()<=60000;
  }
  match /publishedPuzzles/{puzzleId} {
   allow get, list: if true;
   allow create: if isEditor() && validPublicPuzzle(request.resource.data,puzzleId);
   allow update, delete: if false;
  }
  // Aggregate-only public bank metrics; never publish word or clue text.
  // Schema uses fixed keys with strictly numeric values; cannot leak bank rows.
  function validPublicStats(d) {
   return d.keys().hasAll(['schema','source','snapshotAt','totalEntries','rawEntries',
      'duplicateEntries','uniqueAnswers','uniqueClues','uniquePairs']) &&
    d.keys().hasOnly(['schema','source','snapshotAt','totalEntries','rawEntries',
      'duplicateEntries','uniqueAnswers','uniqueClues','uniquePairs']) &&
    d.schema == 1 && d.source == 'jadval-studio' &&
    d.snapshotAt == request.time &&
    d.rawEntries is int && d.rawEntries>=0 && d.rawEntries<=1000000 &&
    d.duplicateEntries is int && d.duplicateEntries>=0 && d.duplicateEntries<=d.rawEntries &&
    d.totalEntries is int && d.totalEntries == d.rawEntries-d.duplicateEntries &&
    d.uniquePairs is int && d.uniquePairs == d.totalEntries &&
    d.uniqueAnswers is int && d.uniqueAnswers>=0 && d.uniqueAnswers<=d.totalEntries &&
    d.uniqueClues is int && d.uniqueClues>=0 && d.uniqueClues<=d.totalEntries &&
    bank().status == 'ready' && bank().count == d.rawEntries;
  }
  match /publicStats/bank {
   allow get: if true;
   allow list: if false;
   allow create, update: if isEditor() && validPublicStats(request.resource.data);
   allow delete: if false;
  }
  match /puzzles/{id} { allow read: if isEditor(); allow write: if false; }
  match /auditLogs/{id} { allow read: if isEditor(); allow write: if false; }
  match /{document=**} { allow read,write: if false; }
 }
}
